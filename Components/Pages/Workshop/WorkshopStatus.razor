@page "/workshop-dashboard"
@layout WorkshopDashboard.Components.Layout.KioskLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@inherits WorkshopDashboard.Components.Helpers.KioskPairingComponentBase

@using BlazorBootstrap
@using QRCoder
@using CsvHelper
@using WorkshopDashboard.Models
@using WorkshopDashboard.Services.Shipping
@using WorkshopDashboard.Services.External.Shipping
@using WorkshopDashboard.Services.Workshop
@using WorkshopDashboard.Services.External.Jms
@using WorkshopDashboard.Services.Jobs
@using WorkshopDashboard.Services.Admin
@using WorkshopDashboard.Services.Stores

@inject NavigationManager Nav
@inject ScopeJobStore ScopeJobs
@inject TurnaroundStatStore TurnaroundStats
@inject ILogger<WorkshopStatus> Logger

@*
    ═══════════════════════════════════════════════════════════════════════
    WorkshopStatus — wall-mounted TV dashboard for the workshop floor.

    The six count tiles are live JMS data via LoadCountsAsync, reloaded every
    30s alongside the clock. (A created-vs-completed monthly chart used to sit
    below them; it was dropped as not telling anyone much, leaving more room
    for big, readable tiles.) Average turnaround is still the hand-typed
    TurnaroundStatStore list (/turnaround-config) — a real version needs
    agreed-on stage definitions (same derived-table shape as
    JmsQueries.BuildScopeResponseTimeQuery) before it's worth building.
    Deliberately leaves out anything negative-toned (overdue counts,
    stuck-job alerts) — that lives on WorkshopNotifications instead.

    Pairing (device code, localStorage device id, poll-until-paired) is
    handled by KioskPairingComponentBase — see that class for the flow, and
    /pair-device for the approval side.
    ═══════════════════════════════════════════════════════════════════════
*@

<PageTitle>Workshop Dashboard</PageTitle>

@if (Initializing)
{
    <div class="d-flex align-items-center justify-content-center" style="min-height:80vh;">
        <Spinner Color="SpinnerColor.Primary" />
    </div>
}
else if (!IsPaired)
{
    <div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height:80vh;">
        <p class="text-muted fs-3 mb-3">To show live data, have a staff member pair this screen</p>
        <div class="pairing-code mb-4">@(PairingCode ?? "——————")</div>
        <p class="text-muted fs-4 mb-4">Scan to open <strong>/pair-device</strong>, or go to it yourself and enter this code</p>
        <div class="home-qr home-qr-lg mb-4">
            @_pairDeviceQrSvg
        </div>
        <div class="d-flex align-items-center gap-2 lan-pill lan-pill-lg">
            <span class="bi bi-hdd-network"></span>
            <span>@_baseUrl</span>
        </div>
    </div>
}
else
{
<div class="kiosk-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Workshop status</h1>
        <p class="text-muted mb-0">@_now.ToString("dddd d MMMM") &middot; @_now.ToString("HH:mm")</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-2 lan-pill">
            <span class="bi bi-hdd-network"></span>
            <span>@_baseUrl</span>
        </div>
        <div class="home-qr">
            @_homeQrSvg
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    @foreach (var (icon, value, label) in Tiles)
    {
        <div class="col">
            <Card Class="h-100 stat-card">
                <CardBody>
                    <div class="d-flex align-items-center gap-4">
                        <div class="stat-icon">@icon</div>
                        <div>
                            <div class="stat-value">@value</div>
                            <div class="stat-label text-muted">@label</div>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>
    }
</div>

<Card>
    <CardHeader>Average turnaround</CardHeader>
    <CardBody>
        @if (_turnaroundStats.Count == 0)
        {
            <p class="text-muted mb-0">
                No stats configured — add some on <a href="/turnaround-config">Turnaround Config</a>.
            </p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-5">
                @foreach (var stat in _turnaroundStats)
                {
                    <div>
                        <div class="turnaround-value">@stat.Days.ToString("0.0") days</div>
                        <div class="text-muted">@stat.Label</div>
                    </div>
                }
            </div>
        }
    </CardBody>
</Card>
}

@code {
    private DateTime _now = DateTime.Now;
    private string _baseUrl = string.Empty;

    // Live via LoadCountsAsync (below) once paired — 0 until that first completes.
    private int _openScopeJobs;
    private int _openWorkshopJobs;
    private int _waitingArrival;
    private int _unitDeparted;
    private int _completedToday;
    private int _completedLast30Days;

    private (string Icon, int Value, string Label)[] Tiles =>
    [
        ("🗂️", _openScopeJobs, "Open scope jobs"),
        ("🔧", _openWorkshopJobs, "Open workshop jobs"),
        ("📥", _waitingArrival, "Waiting arrival"),
        ("📤", _unitDeparted, "Unit departed"),
        ("✅", _completedToday, "Completed today"),
        ("📈", _completedLast30Days, "Completed last 30 days"),
    ];

    // Manually entered on /turnaround-config — no live query behind these
    // yet, same as rule alerts.
    private List<TurnaroundStat> _turnaroundStats = new();

    private System.Threading.Timer? _clockTimer;
    private MarkupString _homeQrSvg;
    private MarkupString _pairDeviceQrSvg;

    protected override async Task OnInitializedAsync()
    {
        // Scheme and port come from Nav.BaseUri (the real values this
        // request was actually served over — no hardcoded https guess), but
        // the host is always a real LAN IP rather than whatever hostname the
        // browser happened to use (localhost, a Pi's mDNS name, etc.) —
        // otherwise neither the pill nor the QR codes would work from another
        // device. Computed up front (not gated behind pairing) since the
        // unpaired screen needs these just as much as the paired one — the
        // whole point is helping someone reach /pair-device from their own
        // device when all they can see is this screen.
        var uri = new Uri(Nav.BaseUri);
        _baseUrl = $"{uri.Scheme}://{GetLanIpAddress()}:{uri.Port}";
        _homeQrSvg = GenerateQrCode(_baseUrl);
        _pairDeviceQrSvg = GenerateQrCode($"{_baseUrl}/pair-device");

        // Local JSON config, not JMS data — doesn't need pairing, so load it
        // up front rather than gating it behind OnPairedAsync.
        _turnaroundStats = await TurnaroundStats.LoadAsync();

        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            _now = DateTime.Now;
            if (IsPaired) await LoadCountsAsync();
            _turnaroundStats = await TurnaroundStats.LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private static MarkupString GenerateQrCode(string url)
    {
        using var qrData = QRCodeGenerator.GenerateQrCode(url, QRCodeGenerator.ECCLevel.M);
        using var svgRenderer = new SvgQRCode(qrData);
        return new MarkupString(svgRenderer.GetGraphic(4));
    }

    private static string GetLanIpAddress()
    {
        try
        {
            foreach (var nic in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces())
            {
                if (nic.OperationalStatus != System.Net.NetworkInformation.OperationalStatus.Up) continue;
                if (nic.NetworkInterfaceType is System.Net.NetworkInformation.NetworkInterfaceType.Loopback or System.Net.NetworkInformation.NetworkInterfaceType.Tunnel) continue;

                foreach (var addr in nic.GetIPProperties().UnicastAddresses)
                {
                    if (addr.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
                        return addr.Address.ToString();
                }
            }
        }
        catch
        {
            // Best-effort — fall through to the placeholder.
        }

        return "unavailable";
    }

    protected override Task OnPairedAsync() => LoadCountsAsync();

    // "Open scope jobs" (scope_open) and "open workshop jobs" (the complement
    // of scope_open within w_open) both come from one query now — see
    // JmsQueries.WorkshopDashboardCountsQuery's comment for the full
    // definition. This was the source of the 5489 vs ~270 discrepancy
    // (was scanning the whole job table, not just the workshop set) and,
    // separately, was using the wrong "open" definition (NOT IN (2, 10)
    // instead of just <> 2).
    private async Task LoadCountsAsync()
    {
        var jms = await GetJmsAsync();
        if (jms is null) return;

        try
        {
            var exclusions = await ScopeJobs.LoadAsync();
            var row = await DashboardLookup.GetWorkshopCountsAsync(jms, exclusions);
            if (row is not null)
            {
                _openScopeJobs = row.ScopeOpen;
                _openWorkshopJobs = Math.Max(0, row.WOpen - row.ScopeOpen);
                _waitingArrival = row.WaitingArrival;
                _unitDeparted = row.UnitDeparted;

                _completedToday = row.CompletedToday;
                _completedLast30Days = row.CompletedLast30Days;
            }
        }
        catch (Exception ex)
        {
            // Fail soft — a degraded JMS response shouldn't crash the kiosk
            // circuit, it should just leave the tiles at their last value.
            Logger.LogWarning(ex, "Loading the dashboard counts failed");
        }
    }

    public override void Dispose()
    {
        _clockTimer?.Dispose();
        base.Dispose();
    }
}
