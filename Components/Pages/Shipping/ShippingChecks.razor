@page "/shipping-checks"
@rendermode InteractiveServer

@inherits JmsComponentBase

@using System.Diagnostics
@using System.Globalization
@using System.Text.RegularExpressions
@using CsvHelper
@using CsvHelper.Configuration
@using Microsoft.AspNetCore.Components.Authorization
@using WorkshopDashboard.Components.Helpers
@using WorkshopDashboard.Models
@using WorkshopDashboard.Services.Shipping
@using WorkshopDashboard.Services.External.Shipping
@using WorkshopDashboard.Services.Workshop
@using WorkshopDashboard.Services.External.Jms
@using WorkshopDashboard.Services.Jobs
@using WorkshopDashboard.Services.Admin
@using WorkshopDashboard.Services.Stores
@using BlazorBootstrap

@inject TrackingService TrackingService
@inject ShippingJobLookup Jobs
@inject TimesheetLoggingService TimesheetLogging
@inject CurrentUserResolver CurrentUser
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<ShippingChecks> Logger

@*
    ═══════════════════════════════════════════════════════════════════════
    ShippingChecks — three independent job-status queues shown as stacked
    tables, each with live carrier tracking resolved from the job's connote/
    notes: Waiting For Arrival At Workshop, Waiting Outward Shipping, Unit
    Departed Workshop.

    ── Services ─────────────────────────────────────────────────────────────
      Jobs            — ShippingJobLookup: GetJobsAsync per status id
      TrackingService — PrimeAllAsync (logs into JMLA + bulk-fetches once,
                        before any per-job lookups) then GetJobTrackingAsync
                        per job

    ── Flow ─────────────────────────────────────────────────────────────────
      GetStuff loads all three job lists in parallel, primes the tracking
      cache once, then fetches tracking for all three lists in parallel —
      each job's tracking result populates its dictionary and re-renders
      immediately (LoadTrackingAsync calls StateHasChanged per result, not
      once at the end) so the table fills in progressively.
    ═══════════════════════════════════════════════════════════════════════
*@

<div class="page-header">
    <h1>Shipping Checks</h1>
</div>

<!-- ───────────────────────── Waiting For Arrival At Workshop ───────────────────────── -->

<h5>Waiting For Arrival At Workshop</h5>

@if (_loadingArrival)
{
    <div class="d-flex align-items-center gap-2">
        <Spinner Color="SpinnerColor.Primary" />
        <span>Loading...</span>
    </div>
}
else if (_arrivalJobs.Count == 0)
{
    <Callout Color="CalloutColor.Info">No jobs found.</Callout>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Job</th>
                <th>Owner</th>
                <th>Model</th>
                <th>Notes</th>
                <th>Connote</th>
                <th>Status Changed</th>
                <th>Tracking</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in _arrivalJobs)
            {
                <tr>
                    <td>
                        <a href="@JmsLinks.JobSummary(job.JobId)"
                           target="_blank" rel="noopener noreferrer">
                            @job.JobId
                        </a>
                    </td>
                    <td>@job.Owner</td>
                    <td>@job.Model</td>
                    <td>@job.Notes</td>
                    <td>@((MarkupString)string.Join("<br />", job.Connote))</td>
                    <td class="@(job.StatusChangeDate < DateTime.Today.AddDays(-7) ? "text-stale-danger" : "")">
                        @job.StatusChangeDate.ToString("dd MMM yyyy")
                    </td>
                    <td>
                        @RenderTracking(_arrivalTracking, job.JobId)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr class="my-4" />

