@code {

    // ── State ────────────────────────────────────────────────────────────────

    private List<ShippingJobRecord> _arrivalJobs = new();
    private List<ShippingJobRecord> _outwardJobs = new();
    private List<ShippingJobRecord> _departedJobs = new();

    private bool _loadingArrival = false;
    private bool _loadingOutward = false;
    private bool _loadingDeparted = false;

    // jobId → TrackingResult, populated after jobs load
    private Dictionary<int, TrackingResult> _arrivalTracking = new();
    private Dictionary<int, TrackingResult> _outwardTracking = new();
    private Dictionary<int, TrackingResult> _departedTracking = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await GetStuff();
    }

    // ── Load ──────────────────────────────────────────────────────────────────

    private async Task GetStuff()
    {
        var sw = Stopwatch.StartNew();

        await Task.WhenAll(
            LoadJobsAsync((int)JobStatus.WaitingForArrivalAtWorkshop, filterHistoryToStatus: true, connoteStatusLabel: "Waiting for arrival at Workshop", jobs: _arrivalJobs, setLoading: v => _loadingArrival = v),
            LoadJobsAsync((int)JobStatus.WaitingOutwardShipping, filterHistoryToStatus: true, connoteStatusLabel: "Waiting Outward Shipping", jobs: _outwardJobs, setLoading: v => _loadingOutward = v),
            LoadJobsAsync((int)JobStatus.UnitDepartedWorkshop, filterHistoryToStatus: false, connoteStatusLabel: "Waiting Outward Shipping", jobs: _departedJobs, setLoading: v => _loadingDeparted = v)
        );

        sw.Stop();
        Logger.LogDebug("Shipping jobs loaded in {Seconds:F2}s", sw.Elapsed.TotalSeconds);

        // Prime the JMLA cache (login + bulk fetch) before any per-job lookups
        await TrackingService.PrimeAllAsync();

        // Kick off tracking lookups concurrently; re-render as each result arrives
        await Task.WhenAll(
            LoadTrackingAsync(_arrivalJobs, _arrivalTracking),
            LoadTrackingAsync(_outwardJobs, _outwardTracking),
            LoadTrackingAsync(_departedJobs, _departedTracking)
        );

        await LogShippingChecksTimesheetAsync();
    }

    // Admin task (not tied to a job) — once per day regardless of how many times this page is
    // loaded, since re-loading the same dashboard isn't new work. 2 min per job actually opened
    // (loaded + tracking resolved), not per table.
    private async Task LogShippingChecksTimesheetAsync()
    {
        var totalJobs = _arrivalJobs.Count + _outwardJobs.Count + _departedJobs.Count;
        if (totalJobs == 0) return;

        var provided = _arrivalTracking.Values.Concat(_outwardTracking.Values).Concat(_departedTracking.Values)
            .Count(t => t.TrackingNumber != null && t.ErrorMessage == null);
        var missing = totalJobs - provided;
        var viewer = await ResolveViewerNameAsync();

        var notes = $"Loaded {totalJobs} jobs, {_arrivalJobs.Count} waiting arrival, "
            + $"{_outwardJobs.Count} waiting outward shipping, {_departedJobs.Count} unit departed.\n"
            + $"Provided {provided} tracking details.\n"
            + $"{missing} jobs did not have tracking details or failed.\n"
            + $"Information provided to {viewer}.";

        await TimesheetLogging.LogAdminTaskAsync(totalJobs * 2.0 / 60, notes, taskKey: "shipping-checks-daily");
    }

    // Distinct from TimesheetLoggingService's fixed technician attribution — this is just who
    // actually consulted the dashboard, for the notes' own audit trail.
    private async Task<string> ResolveViewerNameAsync()
    {
        var resolved = await CurrentUser.ResolveAsync();
        if (resolved is { } r) return r.Name;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        return auth.User.Identity?.Name ?? "unknown user";
    }

    private async Task LoadJobsAsync(int jobStatusId, bool filterHistoryToStatus, string connoteStatusLabel,
                                     List<ShippingJobRecord> jobs, Action<bool> setLoading)
    {
        setLoading(true);
        StateHasChanged();

        var result = await Jobs.GetJobsAsync(jobStatusId, filterHistoryToStatus, connoteStatusLabel);
        jobs.Clear();
        jobs.AddRange(result);

        setLoading(false);
        StateHasChanged();
    }

    // ── Tracking ──────────────────────────────────────────────────────────────

    private async Task LoadTrackingAsync(List<ShippingJobRecord> jobs, Dictionary<int, TrackingResult> results)
    {
        results.Clear();

        var tasks = jobs.Select(async job =>
        {
            var tracking = await TrackingService.GetJobTrackingAsync(job.Connote, job.Notes);
            return (job.JobId, tracking);
        });

        foreach (var (jobId, tracking) in await Task.WhenAll(tasks))
        {
            results[jobId] = tracking;
            StateHasChanged(); // re-render each result as it arrives
        }
    }

    // Renders the tracking cell for a given job — used inline in the table
    private RenderFragment RenderTracking(Dictionary<int, TrackingResult> dict, int jobId) => __builder =>
    {
        if (!dict.TryGetValue(jobId, out var t))
        {
            __builder.AddContent(0, "Loading…");
            return;
        }

        if (t.TrackingNumber == null)
        {
            __builder.AddContent(0, "—");
            return;
        }

        // Carrier badge
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", "badge bg-secondary me-1");
        __builder.AddContent(2, t.Carrier);
        __builder.CloseElement();

        // Status — green if delivered, warning icon if error
        if (t.ErrorMessage != null)
        {
            __builder.OpenElement(3, "span");
            __builder.AddAttribute(4, "class", "text-danger");
            __builder.AddAttribute(5, "title", t.ErrorMessage);
            __builder.AddContent(6, "⚠ Error");
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(3, "span");
            __builder.AddAttribute(4, "class", t.IsDelivered ? "text-success fw-bold" : "");
            __builder.AddContent(5, t.Status);
            __builder.CloseElement();
        }

        // Location + timestamp on a new line if available
        if (t.LastEventTime.HasValue || t.LastLocation != null)
        {
            __builder.OpenElement(6, "br");
            __builder.CloseElement();
            __builder.OpenElement(7, "small");
            __builder.AddAttribute(8, "class", "text-muted");
            var meta = string.Join(" · ", new[]
            {
                t.LastLocation,
                t.LastEventTime?.ToString("dd MMM HH:mm")
                }.Where(s => s != null));
            __builder.AddContent(9, meta);
            __builder.CloseElement();
        }
    };

}
