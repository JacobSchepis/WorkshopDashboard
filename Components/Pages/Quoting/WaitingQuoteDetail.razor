        else _ignoredLoans.Add(loan);
    }
    private Dictionary<string, string> _manuAbbreviations = new();

    // Also gates the "Lifetime Spend" column on the on-screen Pending Quote Approval grid
    // above (not Other Open Jobs), in addition to the emailed report — same field, both
    // surfaces.
    private bool _showLifetimeSpend;

    // Emailed report only — the on-screen ETA column stays, since it's where ETAs are edited.
    private bool _includeEta;

    protected override async Task OnInitializedAsync() => await base.OnInitializedAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadJobsAsync();
    }

    private void GoBack() => Nav.NavigateTo("/waiting-quote");

    // Hide buttons: session-only.
    // A job can carry several unaccepted quotes, each on its own row — so
    // removing a row should drop just that quote, not the whole job. The job
    // row itself only disappears once its last quote (or its quote-less
    // placeholder row) is removed.
    private void RemoveQuoteRow(WqJob job, WqQuote? quote)
    {
        if (quote is { } q)
        {
            job.Quotes.RemoveAll(x => x.QuoteId == q.QuoteId);
            _attachQuoteIds.Remove(q.QuoteId);

            if (job.Quotes.Count > 0) return;
        }

