    // Reset on every reload, since loans are rebuilt as new records.
    private HashSet<WqLoan> _ignoredLoans = new(ReferenceEqualityComparer.Instance);
    private List<WqLoan> SentLoans => _loans.Where(l => !_ignoredLoans.Contains(l)).ToList();

    // The report shows "No loan equipment" when the section is on but empty — but if the
    // customer does have loans and every one was unticked, leave the section out instead of
    // telling them they have none.
    private bool IncludeLoansInReport => _includeLoans && !(_loans.Count > 0 && _ignoredLoans.Count >= _loans.Count);

    private void ToggleLoan(WqLoan loan, bool send)
    {
