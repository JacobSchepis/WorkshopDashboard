@page "/waiting-quote/{CompanyName}/{CompanyIds}"
@rendermode InteractiveServer

@inherits JmsComponentBase

@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using WorkshopDashboard.Components.Helpers
@using WorkshopDashboard.Services.Shipping
@using WorkshopDashboard.Services.External.Shipping
@using WorkshopDashboard.Services.Workshop
@using WorkshopDashboard.Services.External.Email
@using WorkshopDashboard.Services.External.Google
@using WorkshopDashboard.Services.External.Jms
@using WorkshopDashboard.Services.Jobs
@using WorkshopDashboard.Services.Admin
@using WorkshopDashboard.Services.Analytics
@using WorkshopDashboard.Services.Stores
@using WorkshopDashboard.Models
@using BlazorBootstrap

@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ScopeJobStore ScopeJobs
@inject WaitingQuoteEmailConfig EmailConfig
@inject EmailService Gmail
@inject WaitingQuoteJobLookup JobLookup
@inject WaitingWorkshopProcessingService WwpProcessing
@inject LoanEquipmentLookup LoanEquipment
@inject LoanEquipmentOverlayStore LoanOverlays
@inject LoanEquipmentStatusStore LoanStatuses
@inject AnalyticsService Analytics
@inject TimesheetLoggingService TimesheetLogging
@inject ScopeCustomerStore ScopeCustomers
@inject ICustomerCreditSource CreditLookup
@inject ScopeLookupService ScopeLookup
@inject ManufacturerAbbreviationStore ManufacturerAbbreviations
@inject ILogger<WaitingQuoteDetail> Logger

@*
    ═══════════════════════════════════════════════════════════════════════
    WaitingQuoteDetail — interactive view of one company's open summary.

    Report logic (SQL, parsing, urgency, status names, report HTML, contact
    grouping) lives in src/Services/WaitingQuoteReport.cs and is shared with
    the dashboard and the future automated-email job. This page:

      • runs the queries through Jms and hands the CSV to the service
      • renders the two tables with hide (×) and exclude-model (🚫) buttons
      • lets the user pick quote PDFs to attach (per-quote checkboxes)
      • lets the user CC extra addresses and upload ad-hoc file attachments
      • provides the SEND PANEL with three modes (see below)
      • copies the service-built report HTML to the clipboard for Gmail

    ── Departments ────────────────────────────────────────────────────────
      When the ScopeCustomer has Departments, a picker filters every table,
      the preview, the credit card and all send modes to one department's
      jobs (ScopeCustomer.DepartmentForJobContact). _allQuoteJobs /
      _allOtherJobs hold everything loaded; _quoteJobs / _otherJobs are the
      filtered view the rest of the page reads.

    ── Send modes ─────────────────────────────────────────────────────────
      1. Custom person      — free-typed To address, one email, whole report.
      2. Customer contacts  — the Scope Customer Manager contacts: the picked
                              department's primary (To), secondary + our
                              contact (CC); with no department picked, the
                              customer's own primary (To) / secondary (CC).
      3. Per job contact    — one email PER contact (job.contact_name →
                              company_people), each containing only that
                              contact's jobs. Contacts with no email are
                              listed as un-sendable.

    ── Attachments ────────────────────────────────────────────────────────
      Two sources, merged in BuildAttachmentsAsync:
        1. Ticked quote PDFs — fetched via Jms.GetQuotePdfAsync, scoped to the
           jobs in the email (so per-contact sends only carry their own).
        2. Manually uploaded files — held in memory for the session, added to
           EVERY email regardless of mode.

    ── Credit ─────────────────────────────────────────────────────────────
      The customer's credit comes from the shared Google Sheet via
      CustomerCreditLookup (same source as CustomerCreditPage.razor). The
      sheet tab is the picked department's own tab if set, otherwise the
      ScopeCustomer's, and is loaded after the jobs so it never holds up the page.
      The "Include credit summary" checkbox is only enabled once it's loaded.
    ═══════════════════════════════════════════════════════════════════════
*@

<div class="d-flex align-items-center gap-3 mb-3">
    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="GoBack">← Back</Button>
    <h3 class="mb-0">@CompanyName — Open Summary Report</h3>
</div>

@if (!_loading && _customer is { Departments.Count: > 0 })
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <label class="form-label mb-0 text-nowrap">Department</label>
        <select class="form-select" style="max-width: 320px;" value="@_departmentFilter" @onchange="OnDepartmentChangedAsync">
            <option value="@AllDepartments">All jobs (@JobCount(AllDepartments))</option>
            @foreach (var d in _customer.Departments)
            {
                <option value="@d.Name">@d.Name (@JobCount(d.Name))</option>
            }
            @if (JobCount(NoDepartment) > 0)
            {
                <option value="@NoDepartment">No department (@JobCount(NoDepartment))</option>
            }
        </select>
    </div>
}

@if (_loading)
{
    <div class="d-flex align-items-center gap-2">
        <Spinner Color="SpinnerColor.Primary" />
        <span>Loading...</span>
    </div>
}
else
{
    <!-- ── Section 1: Waiting Quote Confirmation ── -->
    <Card Class="mb-4">
        <CardHeader>Pending Quote Approval</CardHeader>
        <CardBody>
            @if (_quoteJobs.Count == 0)
            {
                <p class="text-muted mb-0">No jobs waiting quote confirmation.</p>
            }
            else
            {
                <Grid TItem="QuoteRow" Class="table table-striped align-middle mb-0" Data="QuoteRows()">
                    <GridColumns>
                        <GridColumn TItem="QuoteRow" HeaderText="Job ID">
                            <a href="@JmsLinks.JobSummary(context.Job.JobId)"
                               target="_blank" rel="noopener noreferrer">@context.Job.JobId</a>
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Created">@context.Job.JobCreated.ToString("dd MMM yyyy")</GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Equipment">@context.Job.Equipment</GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Fault">@context.Job.Fault</GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Contact">
                            @if (!string.IsNullOrWhiteSpace(context.Job.ContactName))
                            {
                                <span title="@context.Job.ContactEmail">@context.Job.ContactName</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Quote ID">
                            @if (context.Quote is { } quote)
                            {
                                <Badge Color="@UrgencyBadgeColor(quote.DateSent)">Q-@quote.QuoteId</Badge>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Price">
                            @(context.Quote is { } priceQuote ? $"${priceQuote.Price:N2}" : "—")
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Price (ex GST)">
                            @(context.Quote is { } exGstQuote ? $"${exGstQuote.PriceExGst:N2}" : "—")
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Quote Date">
                            @(context.Quote is { } dateQuote ? dateQuote.DateSent.ToString("dd MMM yyyy") : "—")
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Lifetime Spend">
                            @if (_showLifetimeSpend)
                            {
                                if (context.Job.TotalSpentJobs == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <div>$@context.Job.TotalSpent.ToString("N2")</div>
                                    <div class="text-muted small">@context.Job.TotalSpentJobs repair@(context.Job.TotalSpentJobs == 1 ? "" : "s")</div>
                                }
                            }
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="Attach">
                            @if (context.Quote is { } attachQuote)
                            {
                                <label class="d-flex align-items-center gap-1 mb-0" title="Attach Q-@attachQuote.QuoteId">
                                    <input type="checkbox"
                                           checked="@_attachQuoteIds.Contains(attachQuote.QuoteId)"
                                           @onchange="e => ToggleAttach(attachQuote.QuoteId, e.Value is bool b && b)" />
                                    Q-@attachQuote.QuoteId
                                </label>
                            }
                        </GridColumn>
                        <GridColumn TItem="QuoteRow" HeaderText="">
                            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.ExtraSmall"
                                    @onclick="() => RemoveQuoteRow(context.Job, context.Quote)"
                                    TooltipTitle="@(context.Quote is { } q ? $"Remove Q-{q.QuoteId} (this session only)" : "Hide row (this session only)")">×</Button>
                            @if (context.IsFirstRow && context.Job.ModelId.HasValue)
                            {
                                <Button Color="ButtonColor.Warning" Outline="true" Size="ButtonSize.ExtraSmall"
                                        @onclick="() => ExcludeModelAsync(context.Job)"
                                        TooltipTitle="@($"Exclude model {context.Job.ModelId} from all future reports")">🚫</Button>
                            }
                        </GridColumn>
                    </GridColumns>
                </Grid>
            }
        </CardBody>
    </Card>

    <!-- ── Section 2: Everything else open ── -->
    <Card Class="mb-4">
        <CardHeader>Other Open Jobs</CardHeader>
        <CardBody>
            @if (_otherJobs.Count == 0)
            {
                <p class="text-muted mb-0">No other open jobs.</p>
            }
            else
            {
                <Grid TItem="WqJob" Class="table table-striped align-middle mb-0" Data="_otherJobs.OrderBy(j => j.JobId)">
                    <GridColumns>
                        <GridColumn TItem="WqJob" HeaderText="Job ID">
                            <a href="@JmsLinks.JobSummary(context.JobId)"
                               target="_blank" rel="noopener noreferrer">@context.JobId</a>
                        </GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Created">@context.JobCreated.ToString("dd MMM yyyy")</GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Equipment">@context.Equipment</GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Fault">@context.Fault</GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Contact">
                            @if (!string.IsNullOrWhiteSpace(context.ContactName))
                            {
                                <span title="@context.ContactEmail">@context.ContactName</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Status">
                            <input type="text" class="form-control form-control-sm" style="min-width:9rem;"
                                   value="@WaitingQuoteReport.FriendlyStatus(context.Status)"
                                   @onchange="e => context.Status = e.Value?.ToString() ?? string.Empty" />
                        </GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="Approved PO">
                            @if (string.IsNullOrWhiteSpace(context.ApprovedPoNumbers))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span>@context.ApprovedPoNumbers</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="ETA">
                            @if (context.JobStatusId == (int)JobStatus.WaitingWorkshopProcessing)
                            {
                                @if (context.Eta.HasValue)
                                {
                                    <div>@context.Eta.Value.ToString("dd MMM yyyy")</div>
                                }
                                else
                                {
                                    <div class="text-muted small">Not set</div>
                                }
                                <div class="d-flex gap-1 mt-1">
                                    <input type="date" class="form-control form-control-sm" style="width:auto;" @bind="context.EtaInput" />
                                    <Button Size="ButtonSize.ExtraSmall" Color="ButtonColor.Secondary" Outline="true"
                                            Disabled="context.SavingEta" @onclick="() => SaveEtaAsync(context)">
                                        @(context.SavingEta ? "..." : "Save")
                                    </Button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="WqJob" HeaderText="">
                            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.ExtraSmall"
                                    @onclick="() => RemoveOtherJob(context.JobId)"
                                    TooltipTitle="Hide row (this session only)">×</Button>
                            @if (context.ModelId.HasValue)
                            {
                                <Button Color="ButtonColor.Warning" Outline="true" Size="ButtonSize.ExtraSmall"
                                        @onclick="() => ExcludeModelAsync(context)"
                                        TooltipTitle="@($"Exclude model {context.ModelId} from all future reports")">🚫</Button>
                            }
                        </GridColumn>
                    </GridColumns>
                </Grid>
            }
        </CardBody>
    </Card>

    <!-- ── Section 3: Loans currently with this customer ── -->
    <Card Class="mb-4">
        <CardHeader>Loans</CardHeader>
        <CardBody>
            @if (_loans.Count == 0)
            {
                <p class="text-muted mb-0">No loan equipment currently with this customer.</p>
            }
            else
            {
                <p class="text-muted small">Untick a loan to leave it out of the report — e.g. one that belongs to another department.</p>
                <Grid TItem="WqLoan" Class="table table-striped align-middle mb-0" Data="_loans">
                    <GridColumns>
                        <GridColumn TItem="WqLoan" HeaderText="Send">
                            <input type="checkbox" class="form-check-input" checked="@(!_ignoredLoans.Contains(context))"
                                   @onchange="@(e => ToggleLoan(context, e.Value is true))" />
                        </GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Equipment">
                            <span class="@(_ignoredLoans.Contains(context) ? "text-muted text-decoration-line-through" : "")">@context.Equipment</span>
                        </GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Job">
                            @if (context.JobId.HasValue)
                            {
                                <a href="@JmsLinks.JobSummary(context.JobId)"
                                   target="_blank" rel="noopener noreferrer">@context.JobId</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Loaned">@(context.LoanedDate?.ToString("dd MMM yyyy") ?? "—")</GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Status">@context.StatusLabel</GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Covering For">
                            @if (context.CoveringFor is not { Count: > 0 })
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @foreach (var cov in context.CoveringFor)
                                {
                                    <div>
                                        <a href="@JmsLinks.JobSummary(cov.JobId)"
                                           target="_blank" rel="noopener noreferrer">@cov.JobId</a>
                                        — @cov.Equipment
                                    </div>
                                }
                            }
                        </GridColumn>
                        <GridColumn TItem="WqLoan" HeaderText="Agreement">
                            @if (context.AgreementSigned)
                            {
                                <Badge Color="BadgeColor.Success">Signed</Badge>
                            }
                            else
                            {
                                <Badge Color="BadgeColor.Secondary">Not Signed</Badge>
                            }
                        </GridColumn>
                    </GridColumns>
                </Grid>
            }
        </CardBody>
    </Card>

    <!-- ── Section 4: Credit (shared Google Sheet) ── -->
    <Card Class="mb-4">
        <CardHeader>Credit</CardHeader>
        <CardBody>
            @if (string.IsNullOrWhiteSpace(_creditTabName))
            {
                <p class="text-muted mb-0">
                    No credit sheet tab linked for this customer — link one on the
                    <a href="scope-customers">Scope Customer Manager</a>.
                </p>
            }
            else if (_loadingCredit)
            {
                <div class="d-flex align-items-center gap-2">
                    <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                    <span class="text-muted">Loading credit...</span>
                </div>
            }
            else if (_credit is { Error: { Length: > 0 } })
            {
                <Callout Color="CalloutColor.Danger" Class="mb-0">@_credit.Error</Callout>
            }
            else if (_credit is not null)
            {
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="text-muted small text-uppercase">Total Accrued</div>
                        <div class="fs-5 fw-bold">@(string.IsNullOrWhiteSpace(_credit.TotalAccrued) ? "—" : _credit.TotalAccrued)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted small text-uppercase">Total Remaining</div>
                        <div class="fs-5 fw-bold">@(string.IsNullOrWhiteSpace(_credit.TotalRemaining) ? "—" : _credit.TotalRemaining)</div>
                    </div>
                </div>

                @if (_credit.Lines.Count == 0)
                {
                    <p class="text-muted mb-0">No credit lines recorded.</p>
                }
                else
                {
                    <Grid TItem="CreditLine" Class="table table-striped align-middle mb-0" Data="_credit.Lines">
                        <GridColumns>
                            <GridColumn TItem="CreditLine" HeaderText="Serial Number">@context.SerialNumber</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Model">@context.Model</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Credit Gained">@context.CreditGained</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Credit Deducted">@context.CreditDeducted</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Date">@context.Date</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Quote No.">@context.QuoteNo</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Purchase Offer No.">@context.PurchaseOfferNo</GridColumn>
                            <GridColumn TItem="CreditLine" HeaderText="Remaining Balance">@context.RemainingBalance</GridColumn>
                        </GridColumns>
                    </Grid>
                }
            }
        </CardBody>
    </Card>

    <!-- ── Report preview ── -->
    <Card Class="mb-4">
        <CardHeader>Report Preview</CardHeader>
        <CardBody>
            <p class="text-muted small">Preview reflects hidden/excluded rows and the credit-summary/loans/lifetime-spend/ETA toggles below.</p>
            <div class="bg-white rounded p-3">
                @((MarkupString)WaitingQuoteReport.BuildReportHtml(ReportName, _quoteJobs, _otherJobs, _includeCreditSummary,
                    PreviewMessage, IncludeLoansInReport, SentLoans, _showLifetimeSpend, ReportCredit, _includeEta))
            </div>
        </CardBody>
    </Card>

    <!-- ── Send panel ── -->
    <Card Class="mb-4">
        <CardHeader>Send Report</CardHeader>
        <CardBody>

            <!-- Options that apply to every mode -->
            <div class="mb-3">
                <CheckboxInput Label="Include credit summary" @bind-Value="_includeCreditSummary" Disabled="@(!CreditAvailable)" />
                @if (!CreditAvailable)
                {
                    <div class="text-muted small">@CreditUnavailableReason</div>
                }
            </div>
            <div class="mb-3">
                <CheckboxInput Label="Include loans" @bind-Value="_includeLoans" />
            </div>
            <div class="mb-3">
                <CheckboxInput Label="Include lifetime repair spend" @bind-Value="_showLifetimeSpend" />
            </div>
            <div class="mb-3">
                <CheckboxInput Label="Include ETAs on other open jobs" @bind-Value="_includeEta" />
            </div>
            <div class="mb-3">
                <CheckboxInput Label="@(TimesheetLoggingService.Enabled ? "Test mode — don't send from Scopes (still logs timesheets)" : "Test mode — don't send from Scopes")" @bind-Value="_testMode" />
            </div>

            <p class="text-muted small">
                @{
                    var attachCount = _attachQuoteIds.Count;
                }
                @attachCount quote PDF@(attachCount == 1 ? "" : "s") selected to attach
                @if (_manualAttachments.Count > 0)
                {
                    <text>
                        + @_manualAttachments.Count uploaded file@(_manualAttachments.Count == 1 ? "" : "s")
                        (@FormatSize(TotalManualBytes))
                    </text>
                }
            </p>

            <!-- One message, sent above the whole report in every mode -->
            <div class="mb-3">
                <label class="form-label">
                    Message
                    <span class="text-muted small">
                        — shown above the report. {firstName} becomes the recipient's first name
                        @(_mode switch
                        {
                            SendMode.PerContact => "(each contact's own).",
                            SendMode.Predefined => "(the primary contact's, when there's only one).",
                            _ => "— none is known for a custom recipient, so it's left out (\"Hi,\")."
                        })
                    </span>
                </label>
                <TextAreaInput @bind-Value="_message" Rows="3"
                               Placeholder="Each line becomes its own paragraph." />
            </div>

            <!-- CC + ad-hoc attachments — apply to every mode -->
            <div class="mb-3">
                <label class="form-label">
                    CC
                    <span class="text-muted small">— @ScopesAddress is always CC'd and doesn't need adding</span>
                </label>
                <TextInput @bind-Value="_ccEmail" Placeholder="cc@example.com (comma-separate for multiple)" />

                @if (_mode == SendMode.PerContact && ParseCcInput().Length > 0)
                {
                    var sendableCount = WaitingQuoteReport.GroupByContact(_quoteJobs, _otherJobs).Count(g => g.CanSend);
                    <Alert Color="AlertColor.Warning" Class="mt-2 mb-0">
                        Per-contact mode sends @sendableCount separate email@(sendableCount == 1 ? "" : "s").
                        Anyone CC'd here receives all of them, and every contact sees their address.
                    </Alert>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Extra attachments
                    <span class="text-muted small">— added to every email, on top of any ticked quote PDFs</span>
                </label>

                <InputFile @key="_fileInputKey" OnChange="OnFilesSelectedAsync" multiple class="form-control" />

                @if (_manualAttachments.Count > 0)
                {
                    <ul class="list-group mt-2">
                        @foreach (var f in _manualAttachments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@f.FileName <span class="text-muted small">(@FormatSize(f.Content.LongLength))</span></span>
                                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.ExtraSmall"
                                        @onclick="() => RemoveManualAttachment(f.FileName)"
                                        TooltipTitle="Remove attachment">×</Button>
                            </li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrEmpty(_attachError))
                {
                    <Alert Color="AlertColor.Danger" Class="mt-2 mb-0">@_attachError</Alert>
                }

                @if (TotalManualBytes > MaxTotalManualBytes)
                {
                    <Alert Color="AlertColor.Danger" Class="mt-2 mb-0">
                        Uploaded files total @FormatSize(TotalManualBytes), over the
                        @FormatSize(MaxTotalManualBytes) limit. Remove some before sending.
                        (Quote PDFs are fetched at send time and aren't counted here.)
                    </Alert>
                }
            </div>

            <!-- Mode selector + mode-specific body -->
            <Tabs NavStyle="NavStyle.Pills" Class="mb-3">
                <Tab Title="Customer contacts" Active="@(_mode == SendMode.Predefined)" OnClick="@(() => _mode = SendMode.Predefined)">
                    <Content>
                        @{
                            var recipients = CustomerRecipients();
                        }
                        <p class="text-muted small">
                            One email with the report, to the @(SelectedDepartment is { } sd ? $"{sd.Name} department's" : "customer's") contacts from the
                            <a href="scope-customers">Scope Customer Manager</a>.
                            @if (SelectedDepartment is null && _customer is { Departments.Count: > 0 })
                            {
                                <span>Pick a department above to send to its contacts instead.</span>
                            }
                        </p>
                        @if (_customer is null)
                        {
                            <Alert Color="AlertColor.Warning" Class="mb-0">This company isn't set up on the Scope Customer Manager.</Alert>
                        }
                        else if (recipients.To.Count == 0)
                        {
                            <Alert Color="AlertColor.Warning" Class="mb-0">No primary contacts with an email address to send to.</Alert>
                        }
                        else
                        {
                            <div class="small">
                                <div><strong>To:</strong> @string.Join(", ", recipients.To.Select(c => c.Label))</div>
                                @if (recipients.Cc.Count > 0)
                                {
                                    <div><strong>CC:</strong> @string.Join(", ", recipients.Cc.Select(c => c.Label))</div>
                                }
                            </div>
                        }
                        @if (recipients.MissingEmail.Count > 0)
                        {
                            <div class="text-warning small mt-1">No email in JMS, skipped: @string.Join(", ", recipients.MissingEmail)</div>
                        }
                    </Content>
                </Tab>
                <Tab Title="Custom person" Active="@(_mode == SendMode.Custom)" OnClick="@(() => _mode = SendMode.Custom)">
                    <Content>
                        <p class="text-muted small">One email containing the whole report, to an address you type.</p>
                        <TextInput @bind-Value="_customEmail" Placeholder="recipient@example.com (comma-separate for multiple)" />
                    </Content>
                </Tab>
                <Tab Title="Per job contact" Active="@(_mode == SendMode.PerContact)" OnClick="@(() => _mode = SendMode.PerContact)">
                    <Content>
                        <p class="text-muted small">
                            One email per job contact, each containing only that contact's jobs.
                            Contacts without an email address can't be sent to and are listed below.
                        </p>

                        @{
                            var groups = WaitingQuoteReport.GroupByContact(_quoteJobs, _otherJobs);
                            var sendable = groups.Where(g => g.CanSend).ToList();
                            var unsendable = groups.Where(g => !g.CanSend).ToList();
                        }

                        <ul class="list-group mb-2">
                            @foreach (var g in sendable)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@(g.ContactName ?? g.ContactEmail) <span class="text-muted small">&lt;@g.ContactEmail&gt;</span></span>
                                    <Badge Color="BadgeColor.Secondary">
                                        @(g.QuoteJobs.Count + g.OtherJobs.Count) job@(g.QuoteJobs.Count + g.OtherJobs.Count == 1 ? "" : "s")
                                    </Badge>
                                </li>
                            }
                        </ul>

                        @if (unsendable.Any())
                        {
                            var orphanJobs = unsendable.Sum(g => g.QuoteJobs.Count + g.OtherJobs.Count);
                            <Alert Color="AlertColor.Warning" Class="mb-0">
                                @orphanJobs job@(orphanJobs == 1 ? "" : "s") have no contact email and will be skipped.
                            </Alert>
                        }
                    </Content>
                </Tab>
            </Tabs>

            <!-- Send button + status -->
            <div class="d-flex align-items-center gap-2">
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CopyReportAsync">📋 Copy for Gmail</Button>
                <Button Color="ButtonColor.Primary" @onclick="SendAsync"
                        Disabled="@(_sending || TotalManualBytes > MaxTotalManualBytes)"
                        Loading="_sending" LoadingText="Sending...">Send</Button>
            </div>

            @if (!string.IsNullOrEmpty(_sendStatus))
            {
                <Alert Color="@(_sendSuccess ? AlertColor.Success : AlertColor.Danger)" Class="mt-3 mb-0">@_sendStatus</Alert>
            }
        </CardBody>
    </Card>
}

<script>
    window.copyRichText = async (html) => {
        try {
            const blob = new Blob([html], { type: 'text/html' });
            const item = new ClipboardItem({ 'text/html': blob });
            await navigator.clipboard.write([item]);
        } catch (e) {
            const tmp = document.createElement('div');
            tmp.innerHTML = html;
            await navigator.clipboard.writeText(tmp.innerText);
        }
    };
</script>

@code {
    [Parameter] public string CompanyName { get; set; } = "";
    [Parameter] public string CompanyIds { get; set; } = "";

    // Core report state — populated by LoadJobsAsync(), read from markup broadly.
    private bool _loading = true;
    private List<WqJob> _quoteJobs = new();
    private List<WqJob> _otherJobs = new();
    private List<WqLoan> _loans = new();
    private bool _includeLoans;

