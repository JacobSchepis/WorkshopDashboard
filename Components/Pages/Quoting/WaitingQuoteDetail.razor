    }

    // Reuses WaitingWorkshopProcessingService's ETA note (service_type_id 11, "ETA - yyyy-MM-dd").
    // A full reload is needed afterwards (not just a local update) because a first-time save
    // has no EtaServiceId yet — the next edit needs the freshly created service id to update
    // rather than duplicate the note, same as WaitingWorkshopProcessing.razor.
    private async Task SaveEtaAsync(WqJob job)
    {
        if (job.EtaInput is not { } eta) return;

        job.SavingEta = true;
        StateHasChanged();
        try
        {
            var ok = await WwpProcessing.SaveEtaAsync(int.Parse(job.JobId), job.EtaServiceId, eta,
                msg => Logger.LogWarning("{Message}", msg));
            if (ok)
                await LoadJobsAsync();
        }
        finally
        {
            job.SavingEta = false;
            StateHasChanged();
        }
    }

    // Exclude button: persists model id, removes visible rows, next load
    // excludes in SQL.
    private async Task ExcludeModelAsync(WqJob job)
    {
        if (!job.ModelId.HasValue) return;

        var modelId = job.ModelId.Value;
        await ScopeJobs.AddModelAsync(modelId);

        _quoteJobs.RemoveAll(j => j.ModelId == modelId);
        _otherJobs.RemoveAll(j => j.ModelId == modelId);
        _allQuoteJobs.RemoveAll(j => j.ModelId == modelId);
        _allOtherJobs.RemoveAll(j => j.ModelId == modelId);

        // A ticked quote might belong to a now-removed job — prune the set.
        PruneAttachSelection();
    }

    // ── Grid row projection ─────────────────────────────────────────────────
    // A job with several open quotes needs several table rows, one per quote.
    // Every row gets its own remove (×) button (removing just that quote), but
    // the exclude-model (🚫) button only belongs on the first row for a job —
    // so the Grid's Data source is a flattened (job, quote?, isFirstRow) row
    // list rather than the raw job list.

    private record QuoteRow(WqJob Job, WqQuote? Quote, bool IsFirstRow);

    private IEnumerable<QuoteRow> QuoteRows()
    {
        foreach (var job in _quoteJobs.OrderBy(WaitingQuoteReport.LatestQuoteDate))
        {
            if (job.Quotes.Count == 0)
            {
                yield return new QuoteRow(job, null, true);
                continue;
            }

            var first = true;
            foreach (var q in job.Quotes.OrderBy(q => q.DateSent))
            {
                yield return new QuoteRow(job, q, first);
                first = false;
            }
        }
    }

    private static BadgeColor UrgencyBadgeColor(DateTime dateSent) => WaitingQuoteReport.GetUrgency(dateSent) switch
    {
        WqUrgency.Urgent => BadgeColor.Danger,
        WqUrgency.Medium => BadgeColor.Warning,
        _ => BadgeColor.Success
    };

    // ── Attachment selection ────────────────────────────────────────────────

    private readonly HashSet<string> _attachQuoteIds = new();

    private void ToggleAttach(string quoteId, bool value)
    {
        if (value) _attachQuoteIds.Add(quoteId);
        else _attachQuoteIds.Remove(quoteId);
    }

    private void PruneAttachSelection()
    {
        var live = _quoteJobs.Concat(_otherJobs)
            .SelectMany(j => j.Quotes)
            .Select(q => q.QuoteId)
            .ToHashSet();
        _attachQuoteIds.RemoveWhere(id => !live.Contains(id));
    }

    // ── Ad-hoc file uploads ─────────────────────────────────────────────────
    // Held in memory for the life of the circuit and attached to every email in
    // every mode. Blazor Server streams these over the SignalR circuit, so the
    // caps below are deliberately conservative.

    private const long MaxManualFileBytes = 10 * 1024 * 1024;   // per file
    private const long MaxTotalManualBytes = 20 * 1024 * 1024;  // all files
    private const int MaxManualFileCount = 20;

    private readonly List<EmailAttachment> _manualAttachments = new();
    private string? _attachError;

    // Changing the key forces a fresh <InputFile>, so the same file can be
    // re-picked after being removed.
    private Guid _fileInputKey = Guid.NewGuid();

    private long TotalManualBytes => _manualAttachments.Sum(a => a.Content.LongLength);

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        _attachError = null;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(MaxManualFileCount);
        }
        catch (InvalidOperationException)
        {
            _attachError = $"Select at most {MaxManualFileCount} files at once.";
            _fileInputKey = Guid.NewGuid();
            return;
        }

        foreach (var file in files)
        {
            if (file.Size > MaxManualFileBytes)
            {
                _attachError = $"{file.Name} is {FormatSize(file.Size)} — over the "
                             + $"{FormatSize(MaxManualFileBytes)} per-file limit.";
                continue;
            }

            if (_manualAttachments.Count >= MaxManualFileCount)
            {
                _attachError = $"Attachment limit ({MaxManualFileCount} files) reached.";
                break;
            }

            try
            {
                using var ms = new MemoryStream();
                await using (var stream = file.OpenReadStream(MaxManualFileBytes))
                    await stream.CopyToAsync(ms);

                // Re-picking the same name replaces rather than duplicates.
                _manualAttachments.RemoveAll(a =>
                    string.Equals(a.FileName, file.Name, StringComparison.OrdinalIgnoreCase));

                _manualAttachments.Add(new EmailAttachment
                    {
                        FileName = file.Name,
                        Content = ms.ToArray()
                    });
            }
            catch (Exception ex)
            {
                _attachError = $"Could not read {file.Name}: {ex.Message}";
                Logger.LogError(ex, "Reading upload {File} failed", file.Name);
            }
        }

        _fileInputKey = Guid.NewGuid();
        StateHasChanged();
    }

    private void RemoveManualAttachment(string fileName)
    {
        _manualAttachments.RemoveAll(a =>
            string.Equals(a.FileName, fileName, StringComparison.OrdinalIgnoreCase));
        _attachError = null;
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.#} MB"
            : $"{Math.Max(1, bytes / 1024):0} KB";

    // ── CC ──────────────────────────────────────────────────────────────────
    // Applies to every mode. ScopesAddress is always CC'd on top of this.

    private string _ccEmail = string.Empty;

    // Just what the user typed, split and trimmed. Used by the UI warning.
    private string[] ParseCcInput() =>
        _ccEmail.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // What actually goes on the wire: scopes@ plus the typed addresses,
    // de-duplicated so scopes@ can't be added twice.
    private string[] BuildCcList() =>
        new[] { ScopesAddress }
            .Concat(ParseCcInput())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    // ── Gmail copy ────────────────────────────────────────────────────────────

    private async Task CopyReportAsync()
    {
        var html = WaitingQuoteReport.BuildReportHtml(ReportName, _quoteJobs, _otherJobs, _includeCreditSummary,
            PreviewMessage, IncludeLoansInReport, SentLoans, _showLifetimeSpend, ReportCredit, _includeEta);
        await JS.InvokeVoidAsync("copyRichText", html);
        await Analytics.TrackEventAsync("Waiting quote email copied");
    }

    // ── Send ────────────────────────────────────────────────────────────────

    private enum SendMode { Custom, Predefined, PerContact }
    private SendMode _mode = SendMode.Predefined;
    private string _customEmail = string.Empty;

    // The one message above the report. Pre-filled below (or from the email config's
    // DefaultBodyText), editable per send; {firstName} is filled per email by MessageFor.
    private const string DefaultMessage =
        "Hi {firstName},\n" +
        "Please see your Open Summary Report below. Reply to this email to approve or decline any " +
        "outstanding quotes, or if you have any questions.";

    private string _message = DefaultMessage;

    // {firstName} → the given name, or dropped along with the space before it ("Hi {firstName}," → "Hi,").
    private string MessageFor(string? firstName) => string.IsNullOrWhiteSpace(firstName)
        ? Regex.Replace(_message, @"[ \t]*\{firstName\}", "", RegexOptions.IgnoreCase)
        : Regex.Replace(_message, @"\{firstName\}", firstName.Trim().Replace("$", "$$"), RegexOptions.IgnoreCase);

    // Customer contacts mode greets the primary contact by name only when there's exactly one.
    private string? CustomerContactsFirstName()
    {
        var to = CustomerRecipients().To;
        return to.Count == 1 ? WaitingQuoteReport.FirstName(to[0].Name) : null;
    }

    // What the on-page preview / Gmail copy show. Per-contact mode shows a placeholder, since
    // the real name differs per email.
    private string PreviewMessage => _mode switch
    {
        SendMode.PerContact => MessageFor("[contact's first name]"),
        SendMode.Predefined => MessageFor(CustomerContactsFirstName()),
        _ => MessageFor(null),
    };

    private bool _includeCreditSummary;

    // Credit for this customer (see the Credit section of the header comment).
    // _creditTabName null = no ScopeCustomer match or no tab linked.
    private string? _creditTabName;
    private bool _loadingCredit;
    private CustomerCredit? _credit;

    private bool CreditAvailable => _credit is { Error: null or "" };

    private string CreditUnavailableReason =>
        _creditTabName is null ? "No credit sheet tab linked for this customer."
        : _loadingCredit ? "Loading credit..."
        : "Credit couldn't be loaded — see the Credit card above.";

    // What BuildReportHtml gets — null when unticked or not loaded, so the
    // report never renders a half-loaded or errored credit block.
    private CustomerCredit? ReportCredit => _includeCreditSummary && CreditAvailable ? _credit : null;
    private WaitingQuoteEmailConfig.EmailConfigData _config = new();

    private bool _sending;
    private bool _sendSuccess;
    private string _sendStatus = string.Empty;

    // Blocks the real Gmail send (and the always-on scopes CC, since nothing goes out at all)
    // so this page can be exercised against real jobs — including the timesheet logging below,
    // which still fires — without emailing real customers.
    private bool _testMode;

    // Fetch the ticked quote PDFs for a given set of jobs. Only quotes that
    // (a) belong to one of the supplied jobs AND (b) were ticked to attach are
    // fetched — so per-contact sends only include that contact's own quotes.
    // Quotes with no file, or whose fetch doesn't return a real PDF (e.g. an
    // expired session returning an HTML login page), are skipped.
    //
    // Manually uploaded files are appended last and are NOT job-scoped — they
    // go on every email, including each one in per-contact mode.
    private async Task<List<EmailAttachment>> BuildAttachmentsAsync(IEnumerable<WqJob> jobs)
    {
        var selectedQuotes = jobs
            .SelectMany(j => j.Quotes)
            .Where(q => _attachQuoteIds.Contains(q.QuoteId))
            .ToList();

        var attachments = new List<EmailAttachment>();
        foreach (var q in selectedQuotes)
        {
            if (string.IsNullOrWhiteSpace(q.FileLocation))
                continue;

            var bytes = await JobLookup.GetQuotePdfBytesAsync(q.FileLocation);
            if (bytes is null)
            {
                Logger.LogWarning("Quote Q-{QuoteId} didn't come back as a PDF (session expired?) — not attached", q.QuoteId);
                continue;
            }

            var fileName = Path.GetFileName(q.FileLocation);
            if (string.IsNullOrWhiteSpace(fileName))
                fileName = $"Quote-{q.QuoteId}.pdf";

            attachments.Add(new EmailAttachment { FileName = fileName, Content = bytes });
        }

        // Ad-hoc uploads ride along on every email. If an upload happens to
        // share a name with a fetched quote PDF, suffix it so neither is lost.
        foreach (var manual in _manualAttachments)
        {
            var name = manual.FileName;
            if (attachments.Any(a => string.Equals(a.FileName, name, StringComparison.OrdinalIgnoreCase)))
            {
                var stem = Path.GetFileNameWithoutExtension(name);
                var ext = Path.GetExtension(name);
                name = $"{stem}-attached{ext}";
            }

            attachments.Add(new EmailAttachment { FileName = name, Content = manual.Content });
        }

        return attachments;
    }

    // ── Timesheet logging ──────────────────────────────────────────────────
    // Logs a real JMS timesheet entry per job included in a send — base time for the job
    // update/quote-sent email, plus stacking bonuses for what was actually included for that
    // specific job. See docs/timesheet-logging.md. Runs even in test mode (only the email itself is
    // suppressed there) so this page's logging can be verified against real jobs without
    // emailing real customers.
    private const double QuoteSentBaseHours = 1.0 / 60;
    private const double QuotePdfBonusHours = 1.0 / 60;
    private const double ApprovedPoBonusHours = 1.0 / 60;
    private const double LifetimeSpendBonusHours = 1.0 / 60;

    // Grouped by job id rather than iterated per WqJob — a job can legitimately come back from
    // both the quote-jobs and other-jobs queries (they're independent SQL, not mutually
    // exclusive by job id), which was logging the same job twice. Conditions are OR'd across
    // every occurrence of that job id in the input.
    private List<(int JobId, double EstimatedHours, string Notes)> BuildTimesheetEntries(IEnumerable<WqJob> jobs, string recipientLabel)
    {
        var entries = new List<(int, double, string)>();

        var byJobId = jobs
            .Where(j => int.TryParse(j.JobId, out _))
            .GroupBy(j => j.JobId);

        foreach (var group in byJobId)
        {
            var jobId = int.Parse(group.Key);

            var hours = QuoteSentBaseHours;
            var extras = new List<string>();

            if (group.Any(j => j.Quotes.Any(q => _attachQuoteIds.Contains(q.QuoteId))))
            {
                hours += QuotePdfBonusHours;
                extras.Add("quote PDF attached");
            }

            var approvedPo = group.Select(j => j.ApprovedPoNumbers).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));
            if (!string.IsNullOrWhiteSpace(approvedPo))
            {
                hours += ApprovedPoBonusHours;
                extras.Add($"PO included ({approvedPo})");
            }

            if (_showLifetimeSpend)
            {
                hours += LifetimeSpendBonusHours;
                extras.Add("lifetime repair spend included");
            }

            var notes = $"Job update — quote sent with summary to {recipientLabel}."
                + (extras.Count > 0 ? " Also included: " + string.Join(", ", extras) + "." : "");

            entries.Add((jobId, hours, notes));
        }

        return entries;
    }

    // Returns a short suffix to append to _sendStatus so a failure is visible on the page
    // itself, not just the server console — LogVariableForJobsAsync's results were previously
    // discarded entirely, which is why a failed post here showed no error anywhere.
    private async Task<string> LogQuoteSendTimesheetAsync(IEnumerable<WqJob> jobs, string recipientLabel)
    {
        if (!TimesheetLoggingService.Enabled) return "";

        var entries = BuildTimesheetEntries(jobs, recipientLabel);
        if (entries.Count == 0) return "";

        var results = await TimesheetLogging.LogVariableForJobsAsync(entries);
        var failed = results.Where(r => !r.Success && !r.AlreadyLoggedToday).ToList();

        if (failed.Count > 0)
        {
            Logger.LogWarning("Timesheet logging failed for job(s) {JobIds} — see the TimeSheetService log for why", string.Join(", ", failed.Select(f => f.JobId)));
            return $" ⚠ Timesheet logging FAILED for {failed.Count}/{results.Count} job(s) — check the server log.";
        }

        Logger.LogInformation("Timesheet logged: {Entries}", string.Join(", ", results.Select(r => $"job {r.JobId} = {r.EstimatedHours * 60:0.#}min")));
        return $" Logged timesheet for {results.Count} job(s).";
    }

    private async Task SendAsync()
    {
        _sendStatus = string.Empty;
        _sending = true;
        try
        {
            // Cheap sanity check — a typo'd CC silently drops the whole send
            // at the Gmail API otherwise.
            var badCc = ParseCcInput().Where(a => !a.Contains('@') || a.EndsWith('@')).ToList();
            if (badCc.Count > 0)
            {
                _sendSuccess = false;
                _sendStatus = $"Not a valid CC address: {string.Join(", ", badCc)}";
                return;
            }

            switch (_mode)
            {
                case SendMode.Custom:
                    await SendCustomAsync();
                    break;
                case SendMode.Predefined:
                    await SendPredefinedAsync();
                    break;
                case SendMode.PerContact:
                    await SendPerContactAsync();
                    break;
            }

            var cc = ParseCcInput();
            if (_sendSuccess && cc.Length > 0 && !_testMode)
                _sendStatus += $" CC'd {string.Join(", ", cc)}.";

            if (_sendSuccess && _testMode)
                _sendStatus = "[TEST MODE — nothing sent] " + _sendStatus;
        }
        catch (Exception ex)
        {
            _sendSuccess = false;
            _sendStatus = $"Failed: {ex.Message}";
        }
        finally
        {
            _sending = false;
        }
    }

    // Mode 1 — custom typed recipient(s), whole report in one email.
    private async Task SendCustomAsync()
    {
        var to = _customEmail
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (to.Length == 0)
        {
            _sendSuccess = false;
            _sendStatus = "Enter at least one recipient.";
            return;
        }

        // Whole-report send → attachments span every job.
        var attachments = await BuildAttachmentsAsync(_quoteJobs.Concat(_otherJobs));
        var html = WaitingQuoteReport.BuildReportHtml(ReportName, _quoteJobs, _otherJobs, _includeCreditSummary,
            MessageFor(null), IncludeLoansInReport, SentLoans, _showLifetimeSpend, ReportCredit, _includeEta);
        await ComposeAndSend(to, $"{ReportName} — Open Summary Report", html, attachments);
        var tsStatus = await LogQuoteSendTimesheetAsync(_quoteJobs.Concat(_otherJobs), string.Join(", ", to));

        _sendSuccess = true;
        _sendStatus = $"Sent to {string.Join(", ", to)}.{tsStatus}";
    }

    // Mode 2 — predefined recipient from config, whole report in one email.
    private async Task SendPredefinedAsync()
    {
        var recipients = CustomerRecipients();
        if (recipients.To.Count == 0)
        {
            _sendSuccess = false;
            _sendStatus = "No primary contacts with an email address to send to.";
            return;
        }

        // Whole-report send (for the picked department) → attachments span every shown job.
        var attachments = await BuildAttachmentsAsync(_quoteJobs.Concat(_otherJobs));

        var html = WaitingQuoteReport.BuildReportHtml(ReportName, _quoteJobs, _otherJobs, _includeCreditSummary,
            MessageFor(CustomerContactsFirstName()), IncludeLoansInReport, SentLoans, _showLifetimeSpend, ReportCredit, _includeEta);
        await ComposeAndSend(recipients.To.Select(c => c.Email), $"{ReportName} — Open Summary Report", html, attachments,
            recipients.Cc.Select(c => c.Email));

        var toLabel = string.Join(", ", recipients.To.Select(c => c.Name ?? c.Email));
        var tsStatus = await LogQuoteSendTimesheetAsync(_quoteJobs.Concat(_otherJobs), toLabel);

        _sendSuccess = true;
        _sendStatus = $"Sent to {toLabel}"
                      + (recipients.Cc.Count > 0 ? $", CC {string.Join(", ", recipients.Cc.Select(c => c.Name ?? c.Email))}" : "")
                      + $".{tsStatus}";
    }

    // Mode 3 — one email per job contact, each with only that contact's jobs
    // AND only that contact's ticked quote attachments.
    private async Task SendPerContactAsync()
    {
        var groups = WaitingQuoteReport.GroupByContact(_quoteJobs, _otherJobs);
        var sendable = groups.Where(g => g.CanSend).ToList();

        if (sendable.Count == 0)
        {
            _sendSuccess = false;
            _sendStatus = "No contacts with an email address to send to.";
            return;
        }

        var sent = 0;
        var tsFailures = 0;
        foreach (var g in sendable)
        {
            // Scope both the report AND the attachments to this contact's jobs.
            var attachments = await BuildAttachmentsAsync(g.QuoteJobs.Concat(g.OtherJobs));
            var html = WaitingQuoteReport.BuildReportHtml(ReportName, g.QuoteJobs, g.OtherJobs, _includeCreditSummary,
                MessageFor(WaitingQuoteReport.FirstName(g.ContactName)), IncludeLoansInReport, SentLoans, _showLifetimeSpend, ReportCredit, _includeEta);

            await ComposeAndSend(new[] { g.ContactEmail! },
                $"{ReportName} — Open Summary Report", html, attachments);
            var tsStatus = await LogQuoteSendTimesheetAsync(g.QuoteJobs.Concat(g.OtherJobs), g.ContactName ?? g.ContactEmail!);
            if (tsStatus.Contains("FAILED")) tsFailures++;
            sent++;
        }

        var skipped = groups.Count - sendable.Count;
        _sendSuccess = true;
        _sendStatus = $"Sent {sent} email{(sent == 1 ? "" : "s")}"
                      + (skipped > 0 ? $", skipped {skipped} contact(s) with no email." : ".")
                      + (tsFailures > 0 ? $" ⚠ Timesheet logging failed for {tsFailures} contact(s) — check server console." : "");
    }

    // Shared compose helper. Every email goes out FROM scopes and CCs scopes
    // so the sent copy lands in the scopes inbox too — plus whatever the user
    // typed in the CC box. Config can still override the display name /
    // address if ever needed.
    private const string ScopesAddress = CompanyProfile.WorkshopEmail;
    private const string ScopesDisplayName = "Scopes";

    private async Task ComposeAndSend(IEnumerable<string> to, string subject, string html,
        List<EmailAttachment> attachments, IEnumerable<string>? extraCc = null)
    {
        if (_testMode)
        {
            Logger.LogInformation("Test mode — would send \"{Subject}\" to {To} (not sent, not CC'd)", subject, string.Join(", ", to));
            return;
        }

        var fromName = string.IsNullOrWhiteSpace(_config.FromName) ? ScopesDisplayName : _config.FromName;
        var fromAddress = string.IsNullOrWhiteSpace(_config.FromAddress) ? ScopesAddress : _config.FromAddress;

        var email = Gmail.Compose()
            .To(to.ToArray())
            .Cc(BuildCcList().Concat(extraCc ?? Enumerable.Empty<string>()).Distinct(StringComparer.OrdinalIgnoreCase).ToArray())
            .Subject(subject)
            .HtmlBody(html)
            .From(fromName, fromAddress);

        if (attachments.Count > 0)
            email.AttachRange(attachments);

        await email.SendAsync();
        await Analytics.TrackEventAsync("Waiting quote email sent");
    }

    // ── Load ──────────────────────────────────────────────────────────────────

    private async Task LoadJobsAsync()
    {
        _loading = true;
        StateHasChanged();

        var ids = CompanyIds
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => int.TryParse(s.Trim(), out var id) ? id : -1)
            .Where(id => id > 0)
            .ToList();

        if (ids.Count == 0) { _loading = false; StateHasChanged(); return; }

        // Equipment-name abbreviations (display config, read-only).
        try
        {
            _manuAbbreviations = await ManufacturerAbbreviations.LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Could not load manufacturer abbreviations: {Error}", ex.Message);
        }

        // Email config for the predefined-recipient mode (and shared From).
        _config = await EmailConfig.LoadAsync();

        // Optional: the config can override DefaultMessage. Not required — leave
        // the config alone and the const is used.
        if (!string.IsNullOrWhiteSpace(_config.DefaultBodyText))
            _message = _config.DefaultBodyText;

        var exclusions = await ScopeJobs.LoadAsync();

        (_allQuoteJobs, _allOtherJobs) = await JobLookup.GetJobsAsync(ids, exclusions);

        foreach (var job in _allQuoteJobs.Concat(_allOtherJobs))
            job.Equipment = WaitingQuoteReport.AbbreviateEquipment(job.Equipment, _manuAbbreviations);

        _customer = await FindCustomerAsync(ids);
        _contactDetails = await LoadCustomerContactsAsync(_customer);

        // A reload (e.g. after an ETA save) keeps the picked department if it still exists.
        if (_departmentFilter != AllDepartments && _departmentFilter != NoDepartment && SelectedDepartment is null)
            _departmentFilter = AllDepartments;
        ApplyDepartmentFilter();

        _loans = await LoadLoansAsync(ids);
        _ignoredLoans.Clear();

        _loading = false;
        StateHasChanged();

        await LoadCreditAsync();
    }

    // Matches the ScopeCustomer by its exact company-id set (the route's ids
    // come straight from ScopeCustomer.CompanyIds on WaitingQuote.razor),
    // falling back to the display name in case the list was edited since.
    private async Task<ScopeCustomer?> FindCustomerAsync(List<int> companyIds)
    {
        var customers = await ScopeCustomers.LoadAsync();
        var idSet = companyIds.ToHashSet();
        return customers.FirstOrDefault(c => idSet.SetEquals(c.CompanyIds))
               ?? customers.FirstOrDefault(c => string.Equals(c.DisplayName, CompanyName, StringComparison.OrdinalIgnoreCase));
    }

    // Name + email for every contact the customer and its departments send to, for the
    // Customer contacts send mode.
    private async Task<Dictionary<int, ScopeContactRow>> LoadCustomerContactsAsync(ScopeCustomer? customer)
    {
        if (customer is null) return new();
        var ids = customer.PrimaryContactIds.Concat(customer.SecondaryContactIds)
            .Concat(customer.Departments.SelectMany(d => d.PrimaryContactIds.Concat(d.SecondaryContactIds).Concat(d.OurContactIds)))
            .Distinct().ToList();
        var rows = await ScopeLookup.GetContactDetailsAsync(ids);
        return rows.GroupBy(r => r.ContactId).ToDictionary(g => g.Key, g => g.First());
    }

    // ── Departments ─────────────────────────────────────────────────────────

    private const string AllDepartments = "";
    private const string NoDepartment = "__none__";

    private ScopeCustomer? _customer;
    private Dictionary<int, ScopeContactRow> _contactDetails = new();
    private List<WqJob> _allQuoteJobs = new();
    private List<WqJob> _allOtherJobs = new();
    private string _departmentFilter = AllDepartments;

    private ScopeDepartment? SelectedDepartment =>
        _customer?.Departments.FirstOrDefault(d => d.Name == _departmentFilter);

    // Heading/subject name — the department is added so separate sends are easy to tell apart.
    private string ReportName => SelectedDepartment is { } d ? $"{CompanyName} — {d.Name}" : CompanyName;

    private bool InFilter(WqJob job, string filter)
    {
        if (filter == AllDepartments || _customer is null) return true;
        var dept = _customer.DepartmentForJobContact(job.ContactId);
        return filter == NoDepartment ? dept is null : dept?.Name == filter;
    }

    private int JobCount(string filter) =>
        _allQuoteJobs.Concat(_allOtherJobs).Count(j => InFilter(j, filter));

    private void ApplyDepartmentFilter()
    {
        _quoteJobs = _allQuoteJobs.Where(j => InFilter(j, _departmentFilter)).ToList();
        _otherJobs = _allOtherJobs.Where(j => InFilter(j, _departmentFilter)).ToList();
        PruneAttachSelection();
    }

    private async Task OnDepartmentChangedAsync(ChangeEventArgs e)
    {
        _departmentFilter = e.Value?.ToString() ?? AllDepartments;
        ApplyDepartmentFilter();
        await LoadCreditAsync();
    }

    private record Recipient(string? Name, string Email)
    {
        public string Label => string.IsNullOrWhiteSpace(Name) ? Email : $"{Name} <{Email}>";
    }

    // To = primary contacts, CC = secondary (+ our contact for a department). Contacts with
    // no email in JMS are listed separately so the page can say who was skipped.
    private (List<Recipient> To, List<Recipient> Cc, List<string> MissingEmail) CustomerRecipients()
    {
        var missing = new List<string>();
        if (_customer is null) return (new(), new(), missing);

        var dept = SelectedDepartment;
        var toIds = dept?.PrimaryContactIds ?? _customer.PrimaryContactIds;
        var ccIds = dept is null ? _customer.SecondaryContactIds : dept.SecondaryContactIds.Concat(dept.OurContactIds);

        List<Recipient> Resolve(IEnumerable<int> ids)
        {
            var list = new List<Recipient>();
            foreach (var id in ids.Distinct())
            {
                var row = _contactDetails.GetValueOrDefault(id);
                if (row is null || string.IsNullOrWhiteSpace(row.Email))
                    missing.Add(row?.FullName ?? $"Contact #{id}");
                else
                    list.Add(new Recipient(row.FullName, row.Email.Trim()));
            }
            return list;
        }

        var to = Resolve(toIds);
        var cc = Resolve(ccIds).Where(c => !to.Any(t => t.Email.Equals(c.Email, StringComparison.OrdinalIgnoreCase))).ToList();
        return (to, cc, missing);
    }

    // The picked department's own credit tab if it has one, otherwise the customer's. Skips
    // the sheet read when switching between departments that share the same tab.
    private async Task LoadCreditAsync()
    {
        var tab = SelectedDepartment?.CreditSheetTabName is { Length: > 0 } deptTab ? deptTab : _customer?.CreditSheetTabName;
        _creditTabName = string.IsNullOrWhiteSpace(tab) ? null : tab;
        if (_creditTabName is null) { _credit = null; StateHasChanged(); return; }
        if (_credit is { Error: null or "" } && _credit.TabName == _creditTabName) { StateHasChanged(); return; }
        _credit = null;

        _loadingCredit = true;
        StateHasChanged();

        try
        {
            _credit = await CreditLookup.GetCreditAsync(_creditTabName);
        }
        catch (Exception ex)
        {
            _credit = new CustomerCredit(_creditTabName, "", "", new(), $"Couldn't load credit: {ex.Message}");
        }

        _loadingCredit = false;
        StateHasChanged();
    }

    // "Currently with this customer" isn't something JMS tracks directly — LoanedToCompanyId
    // only exists in LoanEquipmentOverlayStore's local annotations on top of the live LOAN-UNIT
    // fleet (see LoanEquipmentManager.razor, the page that maintains it). So this loads the same
    // two sources that page does and filters to units whose overlay says they're with one of
    // this customer's company ids.
    private async Task<List<WqLoan>> LoadLoansAsync(List<int> companyIds)
    {
        var rows = await LoanEquipment.GetLoanEquipmentAsync();
        if (rows is null) return new();

        var idSet = companyIds.ToHashSet();
        var overlaysByEquipmentId = (await LoanOverlays.LoadAsync()).ToDictionary(o => o.EquipmentId);
        var statusLabelById = (await LoanStatuses.LoadAsync()).ToDictionary(s => s.Id, s => s.Label);

        var matches = rows
            .Select(r =>
            {
                overlaysByEquipmentId.TryGetValue(r.EquipmentId, out var overlay);
                return (Row: r, Overlay: overlay);
            })
            .Where(x => x.Overlay is not null && x.Overlay.LoanedToCompanyId is int cid && idSet.Contains(cid))
            .ToList();

        // CoveringForJobIds is a locally-entered list on the overlay (see LoanEquipmentOverlay) —
        // resolve each to its equipment description in one batched call rather than per-loan.
        var coveringJobIds = matches.SelectMany(x => x.Overlay!.CoveringForJobIds).Distinct().ToList();
        var coveringEquipmentByJobId = await LoadCoveringJobEquipmentAsync(coveringJobIds);

        return matches
            .Select(x => new WqLoan(
                Equipment: FormatLoanEquipmentLabel(x.Row.ManufacturerId, x.Row.ManufacturerName, x.Row.ModelNameNo, x.Row.SerialNo),
                JobId: x.Row.LoanJobId,
                LoanedDate: DateTime.TryParse(x.Row.LoanedDate, out var d) ? d : (DateTime?)null,
                StatusLabel: statusLabelById.GetValueOrDefault(x.Overlay!.Status, x.Overlay!.Status),
                AgreementSigned: x.Row.AgreementCount > 0,
                CoveringFor: x.Overlay.CoveringForJobIds
                    .Select(id => new WqLoanCoveringJob(id, coveringEquipmentByJobId.GetValueOrDefault(id, $"Job {id}")))
                    .ToList()))
            .ToList();
    }

    private async Task<Dictionary<int, string>> LoadCoveringJobEquipmentAsync(List<int> jobIds)
    {
        if (jobIds.Count == 0) return new();

        var rows = await LoanEquipment.GetCoveringJobsAsync(jobIds);
        return rows.ToDictionary(r => r.JobId, r => string.IsNullOrWhiteSpace(r.Equipment) ? $"Job {r.JobId}" : r.Equipment);
    }

    // Same abbreviation convention as WaitingQuoteReport.AbbreviateEquipment/
    // LoanEquipmentManager.razor's FormatModelLabel — ManufacturerAbbreviationStore is keyed
    // by manufacturer id (as a string), not name.
    private string FormatLoanEquipmentLabel(int? manufacturerId, string? manufacturerName, string? modelName, string? serialNo)
    {
        var manuLabel = manufacturerId is int id && _manuAbbreviations.TryGetValue(id.ToString(), out var abbrev)
            ? abbrev
            : manufacturerName ?? "";
        var model = string.IsNullOrWhiteSpace(manuLabel) ? (modelName ?? "") : $"{manuLabel} {modelName}".Trim();
        return string.IsNullOrWhiteSpace(serialNo) ? model : $"{model} ({serialNo})";
    }
}
