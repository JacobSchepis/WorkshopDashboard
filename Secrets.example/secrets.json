{
  // Copy to Secrets/secrets.json (gitignored) and fill in.
  //
  // Jms is required: the app refuses to start until every Jms value is set — see
  // JmsOptions.cs for what each endpoint is used for. Endpoint values are paths relative
  // to BaseUrl, without query strings.

  // Off to use the real services below; on (the appsettings.json default) runs the demo.
  "DemoMode": false,

  "Jms": {
    "BaseUrl": "https://jms.example.com/",
    "LoginLatitude": "0",
    "LoginLongitude": "0",

    // The shared login all reads go through. Writes always use the logged-in user's own session.
    "ServiceAccount": {
      "Username": "",
      "Password": ""
    },

    "Endpoints": {
      "Login": "",
      "AuthCheck": "",

      "Query": "",
      "OpenFile": "",
      "UserSearch": "",
      "JobSticker": "",
      "PartPricingSearch": "",
      "NotYetReceivedItems": "",
      "WorkSummaryReport": "",
      "NotSeenReport": "",
      "ErfaReport": "",
      "DetailedInspectionReport": "",
      "OpenCertificate": "",
      "RsScheduleReport": "",
      "JobRepairSummaryReport": "",
      "RsPerformanceReport": "",

      "LabourConflictCheck": "",

      "JobSummary": "",
      "CreateJob": "",
      "AddJobEquipment": "",
      "AddJobTimesheet": "",
      "AddJobService": "",
      "UpdateJobService": "",
      "AddJobParts": "",
      "CreateRecall": "",
      "JobResourceUpload": "",
      "CreateDeliveryDocket": "",
      "BackgroundJobSubmission": ""
    }
  },

  // Everything below is optional — a service with no settings warns at startup and reports
  // itself unconfigured. Any value can instead come from user secrets or an environment
  // variable, e.g. OpenAI__ApiKey or Jms__ServiceAccount__Password.

  // Quote PDF extraction and the Apex repair suggester.
  "OpenAI": {
    "ApiKey": ""
  },

  // Carrier tracking. FedEx: a developer.fedex.com project with the Track API added.
  "Dhl": {
    "ApiKey": ""
  },
  "FedEx": {
    "ClientId": "",
    "ClientSecret": "",
    "UseSandbox": true
  },
  "Jmla": {
    "Username": "",
    "Password": "",
    "AccountId": ""
  },

  "Monday": {
    "ApiToken": "",
    "PurchasingBoardId": "",
    "OpenOrdersGroupId": "topics",
    "FinalisationGroupId": ""
  },

  // An OAuth "Desktop app" client from Google Cloud Console (Gmail send + Sheets). The first
  // use of each opens a browser for one-time consent; tokens are kept under TokenStorePath.
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "TokenStorePath": "Secrets",
    // From each sheet's URL: https://docs.google.com/spreadsheets/d/{id}/edit?gid={gid}
    "CustomerCreditSheetId": "",
    "LoanEquipmentSheetId": "",
    "LoanEquipmentTabGid": 0
  },

  // The one login that sees the Dev Tools pages. Empty means nobody.
  "DevTools": {
    "AllowedUsername": ""
  }
}
